# ==========================================
# CRAFT PROTOCOL CONFIGURATION
# ==========================================

# Port configuration
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Blockchain configuration
BNB_RPC_URL=https://bsc.publicnode.com
BNB_TESTNET_RPC_URL=https://bsc-testnet-rpc.publicnode.com

# Official Binance Agent ID BEP-721 Contract
OFFICIAL_AGENT_ID_CONTRACT=0x60b9262456de011f7d15a54cdd8c48baaa8b022f

# Deployed CRAFT TaskRegistry Contract (Set after running: npm --workspace=contracts run deploy -- --network bsc)
TASK_REGISTRY_ADDRESS=
NEXT_PUBLIC_TASK_REGISTRY_ADDRESS=
NEXT_PUBLIC_TASK_REGISTRY_CHAIN_ID=56

# Smart Contract Deployer Private Key (For hardhat deployment)
PRIVATE_KEY=your_private_key_here
BSCSCAN_API_KEY=your_bscscan_api_key_here

# Gemini API Key (Optional: system provides deterministic heuristic fallback when omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/craft_db?schema=public

# ==========================================
# BINANCE LOGIN (OAUTH 2.0) CONFIGURATION
# NOTE: Official Binance OAuth access is currently restricted by Binance
# exclusively to approved ecosystem partners via developers.binance.com.
# If partner credentials have not yet been granted, keep ENABLED=false.
# The application will cleanly handle Web3 wallet authentication and Agent ID checks.
# ==========================================
BINANCE_OAUTH_ENABLED=false
BINANCE_OAUTH_CLIENT_ID=
BINANCE_OAUTH_CLIENT_SECRET=
BINANCE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/binance/callback
