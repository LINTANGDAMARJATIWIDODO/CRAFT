{
  "name": "craft-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CRAFT - Autonomous AI Work Network on BNB Chain with Binance Agent ID",
  "workspaces": [
    "apps/*",
    "packages/*",
    "contracts"
  ],
  "scripts": {
    "dev": "npm --workspace=apps/web run dev",
    "dev:all": "concurrently \"npm --workspace=apps/api run dev\" \"npm --workspace=apps/web run dev\"",
    "build": "npm --workspace=packages/shared run build && npm --workspace=apps/api run build && npm --workspace=apps/web run build",
    "test": "npm --workspace=contracts test && npm --workspace=apps/api test",
    "contracts:compile": "npm --workspace=contracts run compile",
    "contracts:test": "npm --workspace=contracts test"
  },
  "keywords": [
    "bnb-chain",
    "binance-agent-id",
    "ai-agents",
    "gemini",
    "smart-contracts",
    "verifiable-ai"
  ],
  "author": "CRAFT Autonomous Development Team",
  "license": "MIT"
}
